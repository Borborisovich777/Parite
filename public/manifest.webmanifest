{
  "name": "Parité",
  "short_name": "Parité",
  "description": "A mobile-first group expense splitting app with multi-currency support.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f1de",
  "theme_color": "#81b29a",
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
