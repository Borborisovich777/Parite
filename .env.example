# These values are embedded in the browser bundle. Use only a public anon or
# publishable key, never a service-role key, provider key, or database password.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_KEY

# Apply all documented database migrations before enabling required approval.
VITE_ACCOUNT_APPROVAL_MODE=required
VITE_RECEIPT_IMPORT_ENABLED=false
